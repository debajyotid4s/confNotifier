# PostgreSQL connection
DATABASE_URL=postgres://user:pass@localhost:5432/bd_conf_bot

# Gemini LLM (OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Telegram bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# CertSpotter API (optional, for SSL certificate monitoring)
CERTSPOTTER_API_KEY=your_certspotter_key_here

# Playwright/Node path for the TypeScript browser agent
PLAYWRIGHT_PATH=node

# LLM daily limit (default: 20)
LLM_DAILY_LIMIT=20

# Days before deadline to send reminders (default: 7)
REMINDER_DAYS_BEFORE=7
